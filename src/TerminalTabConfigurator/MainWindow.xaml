<Window x:Class="TerminalTabConfigurator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:TerminalTabConfigurator.Controls"
        xmlns:l="clr-namespace:TerminalTabConfigurator.Localization"
        xmlns:model="clr-namespace:TerminalTabConfigurator.Core.Model;assembly=TerminalTabConfigurator.Core"
        mc:Ignorable="d"
        Title="TerminalTabConfigurator" Icon="pack://application:,,,/TerminalTabConfigurator;component/Assets/app.ico"
        Width="1360" Height="860" MinWidth="1000" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBackgroundBrush}">

    <Window.Resources>
        <!-- One pane of the preview -->
        <DataTemplate x:Key="PaneTemplate" DataType="{x:Type model:PaneLeaf}">
            <Border x:Name="Frame" Background="{DynamicResource PaneBrush}" BorderBrush="{DynamicResource PaneBorderBrush}"
                    BorderThickness="1" CornerRadius="6" ClipToBounds="True">
                <DockPanel>
                    <Border x:Name="Header" DockPanel.Dock="Top" Background="{DynamicResource PaneHeaderBrush}"
                            BorderBrush="{DynamicResource PaneHeaderLineBrush}" BorderThickness="0,0,0,1" Padding="10,0" MinHeight="34">
                        <DockPanel>
                            <StackPanel x:Name="Actions" DockPanel.Dock="Right" Orientation="Horizontal" Visibility="Collapsed" VerticalAlignment="Center">
                                <Button Style="{StaticResource PaneActionButton}" ToolTip="{l:Tr SplitPaneVertically}"
                                        AutomationProperties.Name="{l:Tr SplitPaneVertically}"
                                        Command="{Binding DataContext.SplitVerticalCommand, RelativeSource={RelativeSource AncestorType=Window}}">
                                    <Path Style="{StaticResource StrokeIcon}" Data="{StaticResource SplitVerticalIcon}" />
                                </Button>
                                <Button Style="{StaticResource PaneActionButton}" ToolTip="{l:Tr SplitPaneHorizontally}"
                                        AutomationProperties.Name="{l:Tr SplitPaneHorizontally}"
                                        Command="{Binding DataContext.SplitHorizontalCommand, RelativeSource={RelativeSource AncestorType=Window}}">
                                    <Path Style="{StaticResource StrokeIcon}" Data="{StaticResource SplitHorizontalIcon}" />
                                </Button>
                                <Button Style="{StaticResource PaneActionButton}" ToolTip="{l:Tr DeleteThisPane}"
                                        AutomationProperties.Name="{l:Tr DeleteThisPane}"
                                        Command="{Binding DataContext.DeletePaneCommand, RelativeSource={RelativeSource AncestorType=Window}}">
                                    <TextBlock Style="{StaticResource GlyphIcon}" FontSize="13" Text="&#xE74D;" />
                                </Button>
                            </StackPanel>
                            <TextBlock DockPanel.Dock="Right" Margin="8,0" VerticalAlignment="Center" FontSize="11"
                                       Foreground="{DynamicResource HintBrush}" TextTrimming="CharacterEllipsis">
                                <TextBlock.Text>
                                    <MultiBinding Converter="{StaticResource ProfileName}">
                                        <Binding Path="Profile" />
                                        <Binding Source="{x:Static l:Loc.Instance}" Path="Language" />
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                            <Ellipse Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center"
                                     Fill="{Binding Number, Converter={StaticResource PaneColor}}" />
                            <TextBlock VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis">
                                <Run Text="{Binding Number, Mode=OneWay}" /><Run Text=" · " /><Run>
                                    <Run.Text>
                                        <MultiBinding Converter="{StaticResource FallbackText}" ConverterParameter="Untitled" Mode="OneWay">
                                            <Binding Path="Title" Mode="OneWay" />
                                            <Binding Source="{x:Static l:Loc.Instance}" Path="Language" />
                                        </MultiBinding>
                                    </Run.Text>
                                </Run>
                            </TextBlock>
                        </DockPanel>
                    </Border>
                    <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource PaneFooterLineBrush}" BorderThickness="0,1,0,0" Padding="10,6">
                        <DockPanel>
                            <TextBlock Style="{StaticResource GlyphIcon}" FontSize="12" Foreground="{DynamicResource HintBrush}" Margin="0,0,6,0" Text="&#xE8B7;" />
                            <TextBlock FontSize="11" Foreground="{DynamicResource HintBrush}" TextTrimming="CharacterEllipsis">
                                <TextBlock.Text>
                                    <MultiBinding Converter="{StaticResource FallbackText}" ConverterParameter="PaneNoFolder">
                                        <Binding Path="StartingDirectory" />
                                        <Binding Source="{x:Static l:Loc.Instance}" Path="Language" />
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                        </DockPanel>
                    </Border>
                    <TextBlock Margin="12,10" FontFamily="{StaticResource MonoFont}" FontSize="12"
                               Foreground="{DynamicResource TerminalTextBrush}" TextWrapping="Wrap">
                        <TextBlock.Text>
                            <MultiBinding Converter="{StaticResource FallbackText}" ConverterParameter="PaneNoCommand">
                                <Binding Path="Commandline" />
                                <Binding Source="{x:Static l:Loc.Instance}" Path="Language" />
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                </DockPanel>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                    <Setter TargetName="Frame" Property="BorderThickness" Value="2" />
                    <Setter TargetName="Header" Property="Background" Value="{DynamicResource PaneHeaderSelectedBrush}" />
                    <Setter TargetName="Actions" Property="Visibility" Value="Visible" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <ContextMenu x:Key="PaneContextMenu">
            <MenuItem Header="{l:Tr SplitVertically}" Command="{Binding SplitVerticalCommand}">
                <MenuItem.Icon>
                    <Path Style="{StaticResource StrokeIcon}" Stroke="{DynamicResource MenuIconBrush}" Data="{StaticResource SplitVerticalIcon}" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="{l:Tr SplitHorizontally}" Command="{Binding SplitHorizontalCommand}">
                <MenuItem.Icon>
                    <Path Style="{StaticResource StrokeIcon}" Stroke="{DynamicResource MenuIconBrush}" Data="{StaticResource SplitHorizontalIcon}" />
                </MenuItem.Icon>
            </MenuItem>
            <Separator />
            <MenuItem Header="{l:Tr DeletePane}" Command="{Binding DeletePaneCommand}" />
        </ContextMenu>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Border Grid.Row="0" Background="{DynamicResource ChromeBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1" Padding="12,8">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <ComboBox MinWidth="180" Margin="0,0,10,0" VerticalAlignment="Center"
                              ItemsSource="{Binding Installations}" SelectedItem="{Binding SelectedInstallation}"
                              AutomationProperties.Name="{l:Tr InstallationLabel}"
                              ToolTip="{Binding SelectedInstallation.SettingsPath}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock>
                                    <TextBlock.Text>
                                        <MultiBinding Converter="{StaticResource InstallationName}">
                                            <Binding />
                                            <Binding Source="{x:Static l:Loc.Instance}" Path="Language" />
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <Button Command="{Binding TestCommand}" Margin="0,0,6,0" Padding="12,6"
                            ToolTip="{l:Tr TestTooltip}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource GlyphIcon}" FontSize="13" Margin="0,0,6,0" Text="&#xE768;" />
                            <TextBlock Text="{l:Tr Test}" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding PublishCommand}" Style="{DynamicResource AccentButtonStyle}" Padding="14,6"
                            Content="{l:Tr AddToTerminal}" />
                    <Button x:Name="PreferencesButton" Style="{StaticResource ToolbarButton}" Margin="8,0,0,0" Click="OnPreferences"
                            ToolTip="{l:Tr Preferences}" AutomationProperties.Name="{l:Tr Preferences}">
                        <TextBlock Style="{StaticResource GlyphIcon}" FontSize="15" Text="&#xE713;" />
                    </Button>
                </StackPanel>

                <WrapPanel VerticalAlignment="Center">
                    <Button Style="{StaticResource ToolbarButton}" Command="{Binding NewLayoutCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource GlyphIcon}" FontSize="13" Margin="0,0,6,0" Text="&#xE710;" />
                            <TextBlock Text="{l:Tr New}" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource ToolbarButton}" Command="{Binding ReloadCommand}" ToolTip="{l:Tr ReloadTooltip}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource GlyphIcon}" FontSize="13" Margin="0,0,6,0" Text="&#xE72C;" />
                            <TextBlock Text="{l:Tr Reload}" />
                        </StackPanel>
                    </Button>
                    <Rectangle Width="1" Height="22" Fill="{DynamicResource ToolbarSeparatorBrush}" Margin="6,0" />
                    <Button Style="{StaticResource ToolbarButton}" Command="{Binding SplitVerticalCommand}">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource StrokeIcon}" Margin="0,0,6,0" Data="{StaticResource SplitVerticalIcon}" />
                            <TextBlock Text="{l:Tr SplitVertically}" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource ToolbarButton}" Command="{Binding SplitHorizontalCommand}">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource StrokeIcon}" Margin="0,0,6,0" Data="{StaticResource SplitHorizontalIcon}" />
                            <TextBlock Text="{l:Tr SplitHorizontally}" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource ToolbarButton}" Command="{Binding EqualizeCommand}" ToolTip="{l:Tr EqualizeTooltip}">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource StrokeIcon}" Margin="0,0,6,0" Data="{StaticResource EqualizeIcon}" />
                            <TextBlock Text="{l:Tr Equalize}" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource ToolbarButton}" Command="{Binding DeletePaneCommand}" ToolTip="{l:Tr DeleteSelectedPaneTooltip}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource GlyphIcon}" FontSize="13" Margin="0,0,6,0" Text="&#xE74D;" />
                            <TextBlock Text="{l:Tr Delete}" />
                        </StackPanel>
                    </Button>
                </WrapPanel>
            </DockPanel>
        </Border>

        <!-- Body -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="340" />
            </Grid.ColumnDefinitions>

            <!-- Layout list -->
            <Border Grid.Column="0" Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,1,0">
                <DockPanel Margin="10,14,10,10">
                    <DockPanel DockPanel.Dock="Top" Margin="6,0,0,8">
                        <Button DockPanel.Dock="Right" Style="{StaticResource PaneActionButton}" Command="{Binding NewLayoutCommand}"
                                ToolTip="{l:Tr NewLayout}" AutomationProperties.Name="{l:Tr NewLayout}">
                            <TextBlock Style="{StaticResource GlyphIcon}" FontSize="12" Text="&#xE710;" />
                        </Button>
                        <TextBlock Text="{l:Tr MyLayoutsHeader}" Style="{StaticResource SectionHeader}" Margin="0" VerticalAlignment="Center" />
                    </DockPanel>
                    <Button DockPanel.Dock="Bottom" Command="{Binding DeleteLayoutCommand}" HorizontalAlignment="Stretch" Margin="0,8,0,0"
                            ToolTip="{l:Tr RemoveLayoutTooltip}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource GlyphIcon}" FontSize="13" Margin="0,0,6,0" Text="&#xE74D;" />
                            <TextBlock Text="{l:Tr RemoveLayout}" />
                        </StackPanel>
                    </Button>
                    <ListBox ItemsSource="{Binding Layouts}" SelectedItem="{Binding SelectedEntry}" Background="Transparent" BorderThickness="0"
                             AutomationProperties.Name="{l:Tr MyLayouts}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="2,4">
                                    <Grid DockPanel.Dock="Left" Width="20" Height="20" Margin="0,0,10,0" VerticalAlignment="Center">
                                        <Image Source="{Binding Layout.Icon, Converter={StaticResource IconImage}}" />
                                        <TextBlock FontFamily="Segoe UI Emoji, Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Text="{Binding Layout.Icon, Converter={StaticResource IconGlyph}}" />
                                    </Grid>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Status}" FontSize="11" Foreground="{DynamicResource ListStatusBrush}" />
                                    </StackPanel>
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- Preview -->
            <DockPanel Grid.Column="1" Margin="20,16,20,12">
                <DockPanel DockPanel.Dock="Top">
                    <Border DockPanel.Dock="Bottom" Height="1" Background="{DynamicResource DividerBrush}" />
                    <Border Background="{DynamicResource TabHeaderBrush}" CornerRadius="6,6,0,0" Padding="14,8" HorizontalAlignment="Left"
                            BorderThickness="0,2,0,0" BorderBrush="{Binding SelectedLayout.TabColor, Converter={StaticResource HexBrush}}"
                            Visibility="{Binding SelectedLayout, Converter={StaticResource NotNullToVisibility}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource GlyphIcon}" FontSize="13" Margin="0,0,8,0" Text="&#xE756;" />
                            <TextBlock FontWeight="SemiBold">
                                <TextBlock.Text>
                                    <MultiBinding Converter="{StaticResource FallbackText}" ConverterParameter="ActivePaneTitle">
                                        <Binding Path="SelectedLayout.TabTitle" />
                                        <Binding Source="{x:Static l:Loc.Instance}" Path="Language" />
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="{l:Tr TabPreview}" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" VerticalAlignment="Bottom" Margin="10,0,0,8" />
                </DockPanel>

                <Border DockPanel.Dock="Top" Margin="0,12,0,0" Padding="12,8" CornerRadius="6"
                        Background="{DynamicResource WarningBackgroundBrush}" BorderBrush="{DynamicResource WarningBorderBrush}" BorderThickness="1"
                        Visibility="{Binding ElevationWarning, Converter={StaticResource NotNullToVisibility}, FallbackValue=Collapsed}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Left" Style="{StaticResource GlyphIcon}" Foreground="{DynamicResource WarningIconBrush}" Margin="0,1,10,0"
                                   VerticalAlignment="Top" Text="&#xE7BA;" />
                        <TextBlock Text="{Binding ElevationWarning}" TextWrapping="Wrap" FontSize="12" />
                    </DockPanel>
                </Border>

                <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource Hint}" FontSize="12" Margin="0,10,0,0"
                           Text="{l:Tr CanvasHint}" />

                <Border Background="{DynamicResource CanvasBrush}" CornerRadius="8" Padding="14" Margin="0,12,0,0">
                    <Grid>
                        <controls:LayoutCanvas Layout="{Binding SelectedLayout}" SelectedPane="{Binding SelectedPane}"
                                               PaneTemplate="{StaticResource PaneTemplate}"
                                               PaneContextMenu="{StaticResource PaneContextMenu}" />

                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="460"
                                    Visibility="{Binding SelectedEntry.Error, Converter={StaticResource NotNullToVisibility}, FallbackValue=Collapsed}">
                            <TextBlock Text="{l:Tr UnreadableTitle}" FontSize="16" FontWeight="SemiBold" TextAlignment="Center" />
                            <TextBlock Text="{Binding SelectedEntry.Error}" Style="{StaticResource Hint}" FontSize="13" TextAlignment="Center" Margin="0,8" />
                            <TextBlock Style="{StaticResource Hint}" FontSize="13" TextAlignment="Center" Text="{l:Tr UnreadableHint}" />
                        </StackPanel>

                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="420"
                                    Visibility="{Binding SelectedEntry, Converter={StaticResource NotNullToVisibility}, ConverterParameter=invert}">
                            <TextBlock Text="{l:Tr NoSelectionTitle}" FontSize="16" FontWeight="SemiBold" TextAlignment="Center" />
                            <TextBlock Style="{StaticResource Hint}" FontSize="13" TextAlignment="Center" Margin="0,8,0,14"
                                       Text="{l:Tr NoSelectionHint}" />
                            <Button HorizontalAlignment="Center" Command="{Binding NewLayoutCommand}" Style="{DynamicResource AccentButtonStyle}"
                                    Padding="14,6" Content="{l:Tr NewLayoutEllipsis}" />
                        </StackPanel>
                    </Grid>
                </Border>
            </DockPanel>

            <!-- Properties -->
            <Border Grid.Column="2" Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1,0,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding SelectedLayout, Converter={StaticResource NotNullToVisibility}, FallbackValue=Collapsed}">
                    <StackPanel Margin="16">

                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="10" Height="10" Margin="0,0,8,0" VerticalAlignment="Center"
                                     Fill="{Binding SelectedPane.Number, Converter={StaticResource PaneColor}}" />
                            <TextBlock FontSize="15" FontWeight="SemiBold">
                                <Run Text="{l:Tr Pane}" /> <Run Text="{Binding SelectedPane.Number, Mode=OneWay}" /> <Run Text="—" /> <Run>
                                    <Run.Text>
                                        <MultiBinding Converter="{StaticResource FallbackText}" ConverterParameter="Untitled" Mode="OneWay">
                                            <Binding Path="SelectedPane.Title" Mode="OneWay" />
                                            <Binding Source="{x:Static l:Loc.Instance}" Path="Language" />
                                        </MultiBinding>
                                    </Run.Text>
                                </Run>
                            </TextBlock>
                        </StackPanel>

                        <TextBlock Text="{l:Tr PaneTitle}" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding SelectedPane.Title, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="{l:Tr PaneTitle}" />

                        <TextBlock Text="{l:Tr WtProfile}" Style="{StaticResource FieldLabel}" />
                        <ComboBox ItemsSource="{Binding Profiles}" DisplayMemberPath="Display" SelectedValuePath="Reference"
                                  SelectedValue="{Binding SelectedPane.Profile, Converter={StaticResource NullToEmpty}}"
                                  AutomationProperties.Name="{l:Tr WtProfile}" HorizontalAlignment="Stretch" />

                        <TextBlock Text="{l:Tr CommandLine}" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding SelectedPane.Commandline, UpdateSourceTrigger=PropertyChanged}"
                                 FontFamily="{StaticResource MonoFont}" FontSize="12"
                                 AutomationProperties.Name="{l:Tr CommandLine}" />
                        <TextBlock Style="{StaticResource Hint}" Text="{l:Tr CommandLineHint}" />

                        <TextBlock Text="{l:Tr StartingDirectory}" Style="{StaticResource FieldLabel}" />
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Command="{Binding BrowseFolderCommand}" Margin="6,0,0,0" Padding="10,6"
                                    ToolTip="{l:Tr BrowseFolders}" AutomationProperties.Name="{l:Tr BrowseFolders}">
                                <TextBlock Style="{StaticResource GlyphIcon}" Text="&#xE8B7;" />
                            </Button>
                            <TextBox Text="{Binding SelectedPane.StartingDirectory, UpdateSourceTrigger=PropertyChanged}"
                                     FontFamily="{StaticResource MonoFont}" FontSize="12"
                                     AutomationProperties.Name="{l:Tr StartingDirectory}" />
                        </DockPanel>

                        <DockPanel Margin="0,12,0,6">
                            <TextBlock DockPanel.Dock="Right" FontSize="12">
                                <Run Text="{Binding SelectedPaneShare, Mode=OneWay, StringFormat={}{0:0}}" /><Run Text=" %" />
                            </TextBlock>
                            <TextBlock Text="{l:Tr SizeInSplit}" FontSize="12" Foreground="{DynamicResource FieldLabelBrush}" />
                        </DockPanel>
                        <Slider Minimum="5" Maximum="95" SmallChange="1" LargeChange="5" IsSnapToTickEnabled="True" TickFrequency="1"
                                Value="{Binding SelectedPaneShare}" IsEnabled="{Binding CanResizeSelectedPane}"
                                AutomationProperties.Name="{l:Tr SizeInSplit}" />

                        <CheckBox Content="{l:Tr FocusOnStart}" Margin="0,12,0,0"
                                  IsChecked="{Binding SelectedPane.FocusOnStart}" />

                        <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,18" />

                        <TextBlock Text="{l:Tr TabSection}" Style="{StaticResource SectionHeader}" />

                        <TextBlock Text="{l:Tr LayoutNameLabel}" Style="{StaticResource FieldLabel}" Margin="0,4,0,6" />
                        <TextBox Text="{Binding SelectedLayout.Name, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{l:Tr LayoutName}" />

                        <TextBlock Text="{l:Tr IconLabel}" Style="{StaticResource FieldLabel}" />
                        <DockPanel>
                            <Border DockPanel.Dock="Left" Width="34" Height="34" CornerRadius="6" Margin="0,0,8,0"
                                    Background="{DynamicResource InputWellBrush}" BorderBrush="{DynamicResource InputWellBorderBrush}" BorderThickness="1">
                                <Grid>
                                    <Image Width="20" Height="20" Source="{Binding SelectedLayout.Icon, Converter={StaticResource IconImage}}" />
                                    <TextBlock FontFamily="Segoe UI Emoji, Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Text="{Binding SelectedLayout.Icon, Converter={StaticResource IconGlyph}}" />
                                </Grid>
                            </Border>
                            <Button DockPanel.Dock="Right" Command="{Binding BrowseIconCommand}" Margin="6,0,0,0" Padding="10,6"
                                    ToolTip="{l:Tr ChooseImage}" AutomationProperties.Name="{l:Tr ChooseImage}">
                                <TextBlock Style="{StaticResource GlyphIcon}" Text="&#xE8B9;" />
                            </Button>
                            <TextBox Text="{Binding SelectedLayout.Icon, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center"
                                     AutomationProperties.Name="{l:Tr Icon}" />
                        </DockPanel>
                        <ItemsControl ItemsSource="{Binding IconSuggestions}" Margin="0,8,0,0" Focusable="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Width="32" Height="32" MinWidth="0" MinHeight="0" Padding="0" Margin="0,0,4,4"
                                            FontFamily="Segoe UI Emoji" FontSize="14" Content="{Binding}"
                                            ToolTip="{Binding}" AutomationProperties.Name="{Binding}"
                                            Command="{Binding DataContext.SetIconCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Style="{StaticResource Hint}" Text="{l:Tr IconHint}" />

                        <TextBlock Text="{l:Tr TabTitle}" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding SelectedLayout.TabTitle, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{l:Tr TabTitle}" />
                        <TextBlock Style="{StaticResource Hint}" Text="{l:Tr TabTitleHint}" />

                        <TextBlock Text="{l:Tr TabColor}" Style="{StaticResource FieldLabel}" />
                        <WrapPanel>
                            <ItemsControl ItemsSource="{Binding TabColors}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Width="30" Height="30" MinWidth="0" MinHeight="0" Padding="0" Margin="0,0,6,6"
                                                ToolTip="{Binding}" AutomationProperties.Name="{Binding}"
                                                Command="{Binding DataContext.SetTabColorCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}">
                                            <Ellipse Width="18" Height="18" Fill="{Binding Converter={StaticResource HexBrush}}" />
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button Width="30" Height="30" MinWidth="0" MinHeight="0" Padding="0" Margin="0,0,6,6"
                                    ToolTip="{l:Tr NoColor}" AutomationProperties.Name="{l:Tr NoColor}"
                                    Command="{Binding SetTabColorCommand}" CommandParameter="{x:Null}">
                                <Ellipse Width="18" Height="18" Stroke="{DynamicResource NoColorStrokeBrush}" StrokeDashArray="2 2" />
                            </Button>
                        </WrapPanel>
                        <DockPanel Margin="0,2,0,0">
                            <Border DockPanel.Dock="Left" Width="22" Height="22" CornerRadius="11" Margin="0,0,8,0" BorderBrush="{DynamicResource SwatchBorderBrush}" BorderThickness="1"
                                    Background="{Binding SelectedLayout.TabColor, Converter={StaticResource HexBrush}}" />
                            <TextBox Text="{Binding SelectedLayout.TabColor, UpdateSourceTrigger=PropertyChanged}"
                                     FontFamily="{StaticResource MonoFont}" FontSize="12" AutomationProperties.Name="{l:Tr TabColorHex}" />
                        </DockPanel>

                        <StackPanel Margin="0,16,0,0" Visibility="{Binding SelectedEntry.IsPublished, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}">
                            <TextBlock Style="{StaticResource Hint}">
                                <Run Text="{l:Tr ActionLabel}" /> <Run Text="{Binding SelectedEntry.ActionId, Mode=OneWay}" FontFamily="{StaticResource MonoFont}" />
                            </TextBlock>
                            <TextBlock Style="{StaticResource Hint}" Visibility="{Binding SelectedEntry.Keys, Converter={StaticResource NotNullToVisibility}, FallbackValue=Collapsed}">
                                <Run Text="{l:Tr KeysLabel}" /> <Run Text="{Binding SelectedEntry.Keys, Mode=OneWay}" FontFamily="{StaticResource MonoFont}" />
                            </TextBlock>
                            <TextBlock Style="{StaticResource Hint}" Text="{l:Tr InNewTabMenu}"
                                       Visibility="{Binding SelectedEntry.InNewTabMenu, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}" />
                            <TextBlock Style="{StaticResource Hint}" Text="{l:Tr HasDesktopShortcut}"
                                       Visibility="{Binding SelectedEntry.HasShortcut, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Generated command -->
        <Border Grid.Row="2" Background="{DynamicResource CommandBarBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0" Padding="14,8">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left" Text="{l:Tr GeneratedCommand}" FontSize="12" FontWeight="SemiBold"
                           Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" Margin="0,0,12,0" />
                <Button DockPanel.Dock="Right" Command="{Binding CopyCommand}" Margin="12,0,0,0" Padding="12,6">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource GlyphIcon}" FontSize="13" Margin="0,0,6,0" Text="&#xE8C8;" />
                        <TextBlock Text="{l:Tr Copy}" />
                    </StackPanel>
                </Button>
                <TextBox Text="{Binding CommandPreview, Mode=OneWay}" IsReadOnly="True" FontFamily="{StaticResource MonoFont}" FontSize="11.5"
                         HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" TextWrapping="NoWrap"
                         AutomationProperties.Name="{l:Tr GeneratedCommandName}" />
            </DockPanel>
        </Border>

        <!-- Status -->
        <Border Grid.Row="3" Background="{DynamicResource ChromeBrush}" Padding="14,5">
            <TextBlock Text="{Binding StatusMessage}" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" TextTrimming="CharacterEllipsis" />
        </Border>
    </Grid>
</Window>
