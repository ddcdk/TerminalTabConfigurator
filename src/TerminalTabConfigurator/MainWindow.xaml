<Window x:Class="TerminalTabConfigurator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:TerminalTabConfigurator.Controls"
        xmlns:model="clr-namespace:TerminalTabConfigurator.Core.Model;assembly=TerminalTabConfigurator.Core"
        mc:Ignorable="d"
        Title="TerminalTabConfigurator" Icon="/Assets/app.ico"
        Width="1360" Height="860" MinWidth="1000" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource AppBackgroundBrush}">

    <Window.Resources>
        <!-- One pane of the preview -->
        <DataTemplate x:Key="PaneTemplate" DataType="{x:Type model:PaneLeaf}">
            <Border x:Name="Frame" Background="{StaticResource PaneBrush}" BorderBrush="{StaticResource PaneBorderBrush}"
                    BorderThickness="1" CornerRadius="6" ClipToBounds="True">
                <DockPanel>
                    <Border x:Name="Header" DockPanel.Dock="Top" Background="{StaticResource PaneHeaderBrush}"
                            BorderBrush="#2A2A2A" BorderThickness="0,0,0,1" Padding="10,0" MinHeight="34">
                        <DockPanel>
                            <StackPanel x:Name="Actions" DockPanel.Dock="Right" Orientation="Horizontal" Visibility="Collapsed" VerticalAlignment="Center">
                                <Button Style="{StaticResource PaneActionButton}" ToolTip="Diviser ce volet verticalement"
                                        AutomationProperties.Name="Diviser ce volet verticalement"
                                        Command="{Binding DataContext.SplitVerticalCommand, RelativeSource={RelativeSource AncestorType=Window}}">
                                    <Path Style="{StaticResource StrokeIcon}" Data="{StaticResource SplitVerticalIcon}" />
                                </Button>
                                <Button Style="{StaticResource PaneActionButton}" ToolTip="Diviser ce volet horizontalement"
                                        AutomationProperties.Name="Diviser ce volet horizontalement"
                                        Command="{Binding DataContext.SplitHorizontalCommand, RelativeSource={RelativeSource AncestorType=Window}}">
                                    <Path Style="{StaticResource StrokeIcon}" Data="{StaticResource SplitHorizontalIcon}" />
                                </Button>
                                <Button Style="{StaticResource PaneActionButton}" ToolTip="Supprimer ce volet"
                                        AutomationProperties.Name="Supprimer ce volet"
                                        Command="{Binding DataContext.DeletePaneCommand, RelativeSource={RelativeSource AncestorType=Window}}">
                                    <TextBlock Style="{StaticResource GlyphIcon}" FontSize="13" Text="&#xE74D;" />
                                </Button>
                            </StackPanel>
                            <TextBlock DockPanel.Dock="Right" Margin="8,0" VerticalAlignment="Center" FontSize="11"
                                       Foreground="#A8A8A8" TextTrimming="CharacterEllipsis"
                                       Text="{Binding Profile, Converter={StaticResource ProfileName}}" />
                            <Ellipse Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center"
                                     Fill="{Binding Number, Converter={StaticResource PaneColor}}" />
                            <TextBlock VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis">
                                <Run Text="{Binding Number, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding DisplayTitle, Mode=OneWay}" />
                            </TextBlock>
                        </DockPanel>
                    </Border>
                    <Border DockPanel.Dock="Bottom" BorderBrush="#1F1F1F" BorderThickness="0,1,0,0" Padding="10,6">
                        <DockPanel>
                            <TextBlock Style="{StaticResource GlyphIcon}" FontSize="12" Foreground="#A8A8A8" Margin="0,0,6,0" Text="&#xE8B7;" />
                            <TextBlock FontSize="11" Foreground="#A8A8A8" TextTrimming="CharacterEllipsis"
                                       Text="{Binding StartingDirectory, TargetNullValue='(dossier du profil)'}" />
                        </DockPanel>
                    </Border>
                    <TextBlock Margin="12,10" FontFamily="{StaticResource MonoFont}" FontSize="12"
                               Foreground="{StaticResource TerminalTextBrush}" TextWrapping="Wrap"
                               Text="{Binding Commandline, TargetNullValue='(commande du profil)'}" />
                </DockPanel>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                    <Setter TargetName="Frame" Property="BorderThickness" Value="2" />
                    <Setter TargetName="Header" Property="Background" Value="#172A33" />
                    <Setter TargetName="Actions" Property="Visibility" Value="Visible" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <ContextMenu x:Key="PaneContextMenu">
            <MenuItem Header="Diviser verticalement" Command="{Binding SplitVerticalCommand}">
                <MenuItem.Icon>
                    <Path Style="{StaticResource StrokeIcon}" Stroke="#E8E8E8" Data="{StaticResource SplitVerticalIcon}" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Diviser horizontalement" Command="{Binding SplitHorizontalCommand}">
                <MenuItem.Icon>
                    <Path Style="{StaticResource StrokeIcon}" Stroke="#E8E8E8" Data="{StaticResource SplitHorizontalIcon}" />
                </MenuItem.Icon>
            </MenuItem>
            <Separator />
            <MenuItem Header="Supprimer le volet" Command="{Binding DeletePaneCommand}" />
        </ContextMenu>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Border Grid.Row="0" Background="{StaticResource ChromeBrush}" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,0,1" Padding="12,8">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <ComboBox MinWidth="180" Margin="0,0,10,0" VerticalAlignment="Center"
                              ItemsSource="{Binding Installations}" SelectedItem="{Binding SelectedInstallation}"
                              AutomationProperties.Name="Installation de Windows Terminal"
                              ToolTip="{Binding SelectedInstallation.SettingsPath}" />
                    <Button Command="{Binding TestCommand}" Margin="0,0,6,0" Padding="12,6"
                            ToolTip="Ouvre la disposition dans une nouvelle fenêtre, sans rien enregistrer">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource GlyphIcon}" FontSize="13" Margin="0,0,6,0" Text="&#xE768;" />
                            <TextBlock Text="Tester" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding PublishCommand}" Style="{DynamicResource AccentButtonStyle}" Padding="14,6"
                            Content="Ajouter à Windows Terminal…" />
                </StackPanel>

                <WrapPanel VerticalAlignment="Center">
                    <Button Style="{StaticResource ToolbarButton}" Command="{Binding NewLayoutCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource GlyphIcon}" FontSize="13" Margin="0,0,6,0" Text="&#xE710;" />
                            <TextBlock Text="Nouvelle" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource ToolbarButton}" Command="{Binding ReloadCommand}" ToolTip="Relire settings.json">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource GlyphIcon}" FontSize="13" Margin="0,0,6,0" Text="&#xE72C;" />
                            <TextBlock Text="Recharger" />
                        </StackPanel>
                    </Button>
                    <Rectangle Width="1" Height="22" Fill="#3A3A3A" Margin="6,0" />
                    <Button Style="{StaticResource ToolbarButton}" Command="{Binding SplitVerticalCommand}">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource StrokeIcon}" Margin="0,0,6,0" Data="{StaticResource SplitVerticalIcon}" />
                            <TextBlock Text="Diviser verticalement" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource ToolbarButton}" Command="{Binding SplitHorizontalCommand}">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource StrokeIcon}" Margin="0,0,6,0" Data="{StaticResource SplitHorizontalIcon}" />
                            <TextBlock Text="Diviser horizontalement" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource ToolbarButton}" Command="{Binding EqualizeCommand}" ToolTip="Donner la même taille à tous les volets">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource StrokeIcon}" Margin="0,0,6,0" Data="{StaticResource EqualizeIcon}" />
                            <TextBlock Text="Égaliser" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource ToolbarButton}" Command="{Binding DeletePaneCommand}" ToolTip="Supprimer le volet sélectionné">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource GlyphIcon}" FontSize="13" Margin="0,0,6,0" Text="&#xE74D;" />
                            <TextBlock Text="Supprimer" />
                        </StackPanel>
                    </Button>
                </WrapPanel>
            </DockPanel>
        </Border>

        <!-- Body -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="340" />
            </Grid.ColumnDefinitions>

            <!-- Layout list -->
            <Border Grid.Column="0" Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,1,0">
                <DockPanel Margin="10,14,10,10">
                    <DockPanel DockPanel.Dock="Top" Margin="6,0,0,8">
                        <Button DockPanel.Dock="Right" Style="{StaticResource PaneActionButton}" Command="{Binding NewLayoutCommand}"
                                ToolTip="Nouvelle disposition" AutomationProperties.Name="Nouvelle disposition">
                            <TextBlock Style="{StaticResource GlyphIcon}" FontSize="12" Text="&#xE710;" />
                        </Button>
                        <TextBlock Text="MES DISPOSITIONS" Style="{StaticResource SectionHeader}" Margin="0" VerticalAlignment="Center" />
                    </DockPanel>
                    <Button DockPanel.Dock="Bottom" Command="{Binding DeleteLayoutCommand}" HorizontalAlignment="Stretch" Margin="0,8,0,0"
                            ToolTip="Retire la disposition de Windows Terminal (ou supprime le brouillon)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource GlyphIcon}" FontSize="13" Margin="0,0,6,0" Text="&#xE74D;" />
                            <TextBlock Text="Retirer / supprimer" />
                        </StackPanel>
                    </Button>
                    <ListBox ItemsSource="{Binding Layouts}" SelectedItem="{Binding SelectedEntry}" Background="Transparent" BorderThickness="0"
                             AutomationProperties.Name="Mes dispositions">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="2,4">
                                    <Grid DockPanel.Dock="Left" Width="20" Height="20" Margin="0,0,10,0" VerticalAlignment="Center">
                                        <Image Source="{Binding Layout.Icon, Converter={StaticResource IconImage}}" />
                                        <TextBlock FontFamily="Segoe UI Emoji, Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Text="{Binding Layout.Icon, Converter={StaticResource IconGlyph}}" />
                                    </Grid>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Status}" FontSize="11" Foreground="#B0B0B0" />
                                    </StackPanel>
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- Preview -->
            <DockPanel Grid.Column="1" Margin="20,16,20,12">
                <DockPanel DockPanel.Dock="Top">
                    <Border DockPanel.Dock="Bottom" Height="1" Background="{StaticResource DividerBrush}" />
                    <Border Background="#2A2A2A" CornerRadius="6,6,0,0" Padding="14,8" HorizontalAlignment="Left"
                            BorderThickness="0,2,0,0" BorderBrush="{Binding SelectedLayout.TabColor, Converter={StaticResource HexBrush}}"
                            Visibility="{Binding SelectedLayout, Converter={StaticResource NotNullToVisibility}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource GlyphIcon}" FontSize="13" Margin="0,0,8,0" Text="&#xE756;" />
                            <TextBlock FontWeight="SemiBold" Text="{Binding SelectedLayout.TabTitle, TargetNullValue='(titre du volet actif)'}" />
                        </StackPanel>
                    </Border>
                    <TextBlock Text="Aperçu de l'onglet" Foreground="#8F8F8F" FontSize="12" VerticalAlignment="Bottom" Margin="10,0,0,8" />
                </DockPanel>

                <Border DockPanel.Dock="Top" Margin="0,12,0,0" Padding="12,8" CornerRadius="6"
                        Background="#2B2416" BorderBrush="#7A5E1E" BorderThickness="1"
                        Visibility="{Binding ElevationWarning, Converter={StaticResource NotNullToVisibility}, FallbackValue=Collapsed}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Left" Style="{StaticResource GlyphIcon}" Foreground="#F7B955" Margin="0,1,10,0"
                                   VerticalAlignment="Top" Text="&#xE7BA;" />
                        <TextBlock Text="{Binding ElevationWarning}" TextWrapping="Wrap" FontSize="12" />
                    </DockPanel>
                </Border>

                <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource Hint}" FontSize="12" Margin="0,10,0,0"
                           Text="Cliquez un volet pour le sélectionner · glissez un séparateur pour redimensionner · clic droit sur un volet pour le diviser" />

                <Border Background="{StaticResource CanvasBrush}" CornerRadius="8" Padding="14" Margin="0,12,0,0">
                    <Grid>
                        <controls:LayoutCanvas Layout="{Binding SelectedLayout}" SelectedPane="{Binding SelectedPane}"
                                               PaneTemplate="{StaticResource PaneTemplate}"
                                               PaneContextMenu="{StaticResource PaneContextMenu}" />

                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="460"
                                    Visibility="{Binding SelectedEntry.Error, Converter={StaticResource NotNullToVisibility}, FallbackValue=Collapsed}">
                            <TextBlock Text="Cette disposition n'a pas pu être relue" FontSize="16" FontWeight="SemiBold" TextAlignment="Center" />
                            <TextBlock Text="{Binding SelectedEntry.Error}" Style="{StaticResource Hint}" FontSize="13" TextAlignment="Center" Margin="0,8" />
                            <TextBlock Style="{StaticResource Hint}" FontSize="13" TextAlignment="Center"
                                       Text="Elle a sans doute été modifiée à la main dans settings.json. Vous pouvez la retirer, ou la corriger puis recharger." />
                        </StackPanel>

                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="420"
                                    Visibility="{Binding SelectedEntry, Converter={StaticResource NotNullToVisibility}, ConverterParameter=invert}">
                            <TextBlock Text="Aucune disposition sélectionnée" FontSize="16" FontWeight="SemiBold" TextAlignment="Center" />
                            <TextBlock Style="{StaticResource Hint}" FontSize="13" TextAlignment="Center" Margin="0,8,0,14"
                                       Text="Choisissez une disposition dans la liste, ou créez-en une à partir d'un modèle." />
                            <Button HorizontalAlignment="Center" Command="{Binding NewLayoutCommand}" Style="{DynamicResource AccentButtonStyle}"
                                    Padding="14,6" Content="Nouvelle disposition…" />
                        </StackPanel>
                    </Grid>
                </Border>
            </DockPanel>

            <!-- Properties -->
            <Border Grid.Column="2" Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource DividerBrush}" BorderThickness="1,0,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding SelectedLayout, Converter={StaticResource NotNullToVisibility}, FallbackValue=Collapsed}">
                    <StackPanel Margin="16">

                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="10" Height="10" Margin="0,0,8,0" VerticalAlignment="Center"
                                     Fill="{Binding SelectedPane.Number, Converter={StaticResource PaneColor}}" />
                            <TextBlock FontSize="15" FontWeight="SemiBold">
                                <Run Text="Volet" /> <Run Text="{Binding SelectedPane.Number, Mode=OneWay}" /> <Run Text="—" /> <Run Text="{Binding SelectedPane.Title, Mode=OneWay, TargetNullValue='sans titre'}" />
                            </TextBlock>
                        </StackPanel>

                        <TextBlock Text="Titre du volet" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding SelectedPane.Title, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="Titre du volet" />

                        <TextBlock Text="Profil Windows Terminal" Style="{StaticResource FieldLabel}" />
                        <ComboBox ItemsSource="{Binding Profiles}" DisplayMemberPath="Display" SelectedValuePath="Reference"
                                  SelectedValue="{Binding SelectedPane.Profile, Converter={StaticResource NullToEmpty}}"
                                  AutomationProperties.Name="Profil Windows Terminal" HorizontalAlignment="Stretch" />

                        <TextBlock Text="Ligne de commande" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding SelectedPane.Commandline, UpdateSourceTrigger=PropertyChanged}"
                                 FontFamily="{StaticResource MonoFont}" FontSize="12"
                                 AutomationProperties.Name="Ligne de commande" />
                        <TextBlock Style="{StaticResource Hint}" Text="Vide = la commande du profil. Ex. : pwsh.exe -NoExit -Command &quot;npm run dev&quot;" />

                        <TextBlock Text="Dossier de démarrage" Style="{StaticResource FieldLabel}" />
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Command="{Binding BrowseFolderCommand}" Margin="6,0,0,0" Padding="10,6"
                                    ToolTip="Parcourir les dossiers" AutomationProperties.Name="Parcourir les dossiers">
                                <TextBlock Style="{StaticResource GlyphIcon}" Text="&#xE8B7;" />
                            </Button>
                            <TextBox Text="{Binding SelectedPane.StartingDirectory, UpdateSourceTrigger=PropertyChanged}"
                                     FontFamily="{StaticResource MonoFont}" FontSize="12"
                                     AutomationProperties.Name="Dossier de démarrage" />
                        </DockPanel>

                        <DockPanel Margin="0,12,0,6">
                            <TextBlock DockPanel.Dock="Right" FontSize="12">
                                <Run Text="{Binding SelectedPaneShare, Mode=OneWay, StringFormat={}{0:0}}" /><Run Text=" %" />
                            </TextBlock>
                            <TextBlock Text="Taille dans sa division" FontSize="12" Foreground="#C8C8C8" />
                        </DockPanel>
                        <Slider Minimum="5" Maximum="95" SmallChange="1" LargeChange="5" IsSnapToTickEnabled="True" TickFrequency="1"
                                Value="{Binding SelectedPaneShare}" IsEnabled="{Binding CanResizeSelectedPane}"
                                AutomationProperties.Name="Taille dans sa division" />

                        <CheckBox Content="Focus sur ce volet à l'ouverture" Margin="0,12,0,0"
                                  IsChecked="{Binding SelectedPane.FocusOnStart}" />

                        <Border Height="1" Background="{StaticResource DividerBrush}" Margin="0,18" />

                        <TextBlock Text="ONGLET" Style="{StaticResource SectionHeader}" />

                        <TextBlock Text="Nom (palette de commandes et menu)" Style="{StaticResource FieldLabel}" Margin="0,4,0,6" />
                        <TextBox Text="{Binding SelectedLayout.Name, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Nom de la disposition" />

                        <TextBlock Text="Icône (palette de commandes et menu)" Style="{StaticResource FieldLabel}" />
                        <DockPanel>
                            <Border DockPanel.Dock="Left" Width="34" Height="34" CornerRadius="6" Margin="0,0,8,0"
                                    Background="#141414" BorderBrush="#3A3A3A" BorderThickness="1">
                                <Grid>
                                    <Image Width="20" Height="20" Source="{Binding SelectedLayout.Icon, Converter={StaticResource IconImage}}" />
                                    <TextBlock FontFamily="Segoe UI Emoji, Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Text="{Binding SelectedLayout.Icon, Converter={StaticResource IconGlyph}}" />
                                </Grid>
                            </Border>
                            <Button DockPanel.Dock="Right" Command="{Binding BrowseIconCommand}" Margin="6,0,0,0" Padding="10,6"
                                    ToolTip="Choisir une image" AutomationProperties.Name="Choisir une image">
                                <TextBlock Style="{StaticResource GlyphIcon}" Text="&#xE8B9;" />
                            </Button>
                            <TextBox Text="{Binding SelectedLayout.Icon, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center"
                                     AutomationProperties.Name="Icône" />
                        </DockPanel>
                        <ItemsControl ItemsSource="{Binding IconSuggestions}" Margin="0,8,0,0" Focusable="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Width="32" Height="32" MinWidth="0" MinHeight="0" Padding="0" Margin="0,0,4,4"
                                            FontFamily="Segoe UI Emoji" FontSize="14" Content="{Binding}"
                                            ToolTip="{Binding}" AutomationProperties.Name="{Binding}"
                                            Command="{Binding DataContext.SetIconCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Style="{StaticResource Hint}"
                                   Text="Image (.png, .ico, .jpg), emoji ou glyphe Segoe Fluent Icons. Vide = aucune icône. Un fichier .ico sert aussi d'icône au raccourci Bureau." />

                        <TextBlock Text="Titre de l'onglet" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding SelectedLayout.TabTitle, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Titre de l'onglet" />
                        <TextBlock Style="{StaticResource Hint}"
                                   Text="Indépendant des titres de volets. Vide = l'onglet affiche le titre du volet actif." />

                        <TextBlock Text="Couleur de l'onglet" Style="{StaticResource FieldLabel}" />
                        <WrapPanel>
                            <ItemsControl ItemsSource="{Binding TabColors}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Width="30" Height="30" MinWidth="0" MinHeight="0" Padding="0" Margin="0,0,6,6"
                                                ToolTip="{Binding}" AutomationProperties.Name="{Binding}"
                                                Command="{Binding DataContext.SetTabColorCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}">
                                            <Ellipse Width="18" Height="18" Fill="{Binding Converter={StaticResource HexBrush}}" />
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button Width="30" Height="30" MinWidth="0" MinHeight="0" Padding="0" Margin="0,0,6,6"
                                    ToolTip="Aucune couleur" AutomationProperties.Name="Aucune couleur"
                                    Command="{Binding SetTabColorCommand}" CommandParameter="{x:Null}">
                                <Ellipse Width="18" Height="18" Stroke="#8A8A8A" StrokeDashArray="2 2" />
                            </Button>
                        </WrapPanel>
                        <DockPanel Margin="0,2,0,0">
                            <Border DockPanel.Dock="Left" Width="22" Height="22" CornerRadius="11" Margin="0,0,8,0" BorderBrush="#4A4A4A" BorderThickness="1"
                                    Background="{Binding SelectedLayout.TabColor, Converter={StaticResource HexBrush}}" />
                            <TextBox Text="{Binding SelectedLayout.TabColor, UpdateSourceTrigger=PropertyChanged}"
                                     FontFamily="{StaticResource MonoFont}" FontSize="12" AutomationProperties.Name="Couleur de l'onglet (hexadécimal)" />
                        </DockPanel>

                        <StackPanel Margin="0,16,0,0" Visibility="{Binding SelectedEntry.IsPublished, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}">
                            <TextBlock Style="{StaticResource Hint}">
                                <Run Text="Action :" /> <Run Text="{Binding SelectedEntry.ActionId, Mode=OneWay}" FontFamily="{StaticResource MonoFont}" />
                            </TextBlock>
                            <TextBlock Style="{StaticResource Hint}" Visibility="{Binding SelectedEntry.Keys, Converter={StaticResource NotNullToVisibility}, FallbackValue=Collapsed}">
                                <Run Text="Raccourci clavier :" /> <Run Text="{Binding SelectedEntry.Keys, Mode=OneWay}" FontFamily="{StaticResource MonoFont}" />
                            </TextBlock>
                            <TextBlock Style="{StaticResource Hint}" Text="Présente dans le menu « Nouvel onglet »"
                                       Visibility="{Binding SelectedEntry.InNewTabMenu, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}" />
                            <TextBlock Style="{StaticResource Hint}" Text="Raccourci présent sur le Bureau"
                                       Visibility="{Binding SelectedEntry.HasShortcut, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Generated command -->
        <Border Grid.Row="2" Background="#181818" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,1,0,0" Padding="14,8">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left" Text="Commande générée" FontSize="12" FontWeight="SemiBold"
                           Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center" Margin="0,0,12,0" />
                <Button DockPanel.Dock="Right" Command="{Binding CopyCommand}" Margin="12,0,0,0" Padding="12,6">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource GlyphIcon}" FontSize="13" Margin="0,0,6,0" Text="&#xE8C8;" />
                        <TextBlock Text="Copier" />
                    </StackPanel>
                </Button>
                <TextBox Text="{Binding CommandPreview, Mode=OneWay}" IsReadOnly="True" FontFamily="{StaticResource MonoFont}" FontSize="11.5"
                         HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" TextWrapping="NoWrap"
                         AutomationProperties.Name="Commande wt.exe générée" />
            </DockPanel>
        </Border>

        <!-- Status -->
        <Border Grid.Row="3" Background="{StaticResource ChromeBrush}" Padding="14,5">
            <TextBlock Text="{Binding StatusMessage}" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" TextTrimming="CharacterEllipsis" />
        </Border>
    </Grid>
</Window>
