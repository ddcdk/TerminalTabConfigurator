<Window x:Class="TerminalTabConfigurator.Dialogs.PublishWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:TerminalTabConfigurator.Localization"
        Title="{l:Tr PublishWindowTitle}"
        Width="900" Height="720" MinWidth="760" MinHeight="560"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource AppBackgroundBrush}">

    <DockPanel Margin="20">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock x:Name="HeaderText" FontSize="18" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
            <TextBlock Style="{StaticResource Hint}" FontSize="12" Margin="0,4,0,0">
                <Run Text="{l:Tr Target}" /> <Run x:Name="TargetName" FontWeight="SemiBold" /> <Run Text="—" /> <Run x:Name="TargetPath" FontFamily="{StaticResource MonoFont}" />
            </TextBlock>
            <Border x:Name="ElevationBanner" Visibility="Collapsed" Margin="0,12,0,0" Padding="12,10" CornerRadius="6"
                    Background="{DynamicResource WarningBackgroundBrush}" BorderBrush="{DynamicResource WarningBorderBrush}" BorderThickness="1">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource GlyphIcon}" Foreground="{DynamicResource WarningIconBrush}" Margin="0,1,10,0"
                               VerticalAlignment="Top" Text="&#xE7BA;" />
                    <TextBlock TextWrapping="Wrap" FontSize="12">
                        <Run FontWeight="SemiBold" Text="{l:Tr ElevatedLayout}" />
                        <Run Text="{l:Tr ElevatedLayoutText}" />
                    </TextBlock>
                </DockPanel>
            </Border>
        </StackPanel>

        <DockPanel DockPanel.Dock="Bottom" Margin="0,16,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="{l:Tr Cancel}" IsCancel="True" MinWidth="100" Margin="0,0,8,0" />
                <Button x:Name="PublishButton" Content="{l:Tr Publish}" IsDefault="True" MinWidth="110" Style="{DynamicResource AccentButtonStyle}" Click="OnPublish" />
            </StackPanel>
            <TextBlock Style="{StaticResource Hint}" FontSize="12" VerticalAlignment="Center" Margin="0,0,16,0"
                       Text="{l:Tr PublishFooter}" />
        </DockPanel>

        <Grid Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="330" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="{l:Tr WhereToAdd}" Style="{StaticResource SectionHeader}" />

                    <CheckBox IsChecked="True" IsEnabled="False">
                        <StackPanel>
                            <TextBlock Text="{l:Tr CommandPalette}" />
                            <TextBlock Style="{StaticResource Hint}" Text="{l:Tr PaletteAlways}" Margin="0,2,0,0" />
                        </StackPanel>
                    </CheckBox>

                    <CheckBox x:Name="KeysCheck" Margin="0,12,0,0" Checked="OnOptionChanged" Unchecked="OnOptionChanged">
                        <TextBlock Text="{l:Tr KeyboardShortcut}" />
                    </CheckBox>
                    <TextBox x:Name="KeysBox" Margin="28,6,0,0" FontFamily="{StaticResource MonoFont}" FontSize="12"
                             IsEnabled="{Binding IsChecked, ElementName=KeysCheck}" TextChanged="OnKeysChanged"
                             AutomationProperties.Name="{l:Tr KeyboardShortcut}" />
                    <TextBlock Style="{StaticResource Hint}" Margin="28,4,0,0" Text="{l:Tr KeysExample}" />
                    <TextBlock x:Name="KeysWarning" Margin="28,4,0,0" FontSize="12" Foreground="{DynamicResource WarningIconBrush}" TextWrapping="Wrap" Visibility="Collapsed" />

                    <CheckBox x:Name="MenuCheck" Margin="0,12,0,0" Checked="OnOptionChanged" Unchecked="OnOptionChanged">
                        <StackPanel>
                            <TextBlock Text="{l:Tr NewTabMenu}" />
                            <TextBlock Style="{StaticResource Hint}" Margin="0,2,0,0" Text="{l:Tr NewTabMenuHint}" />
                        </StackPanel>
                    </CheckBox>

                    <CheckBox x:Name="ShortcutCheck" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="{l:Tr DesktopShortcut}" />
                            <TextBlock x:Name="ShortcutHint" Style="{StaticResource Hint}" Margin="0,2,0,0" />
                        </StackPanel>
                    </CheckBox>

                    <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,18" />

                    <CheckBox x:Name="BackupCheck" IsChecked="True">
                        <StackPanel>
                            <TextBlock Text="{l:Tr BackupBefore}" />
                            <TextBlock Style="{StaticResource Hint}" Margin="0,2,0,0" Text="{l:Tr BackupHint}" />
                        </StackPanel>
                    </CheckBox>
                </StackPanel>
            </ScrollViewer>

            <DockPanel Grid.Column="2">
                <TextBlock DockPanel.Dock="Top" Text="{l:Tr JsonPreviewHeader}" Style="{StaticResource SectionHeader}" />
                <TextBox x:Name="JsonPreview" IsReadOnly="True" FontFamily="{StaticResource MonoFont}" FontSize="11.5"
                         Background="{DynamicResource InputWellBrush}" Foreground="{DynamicResource TerminalTextBrush}" Padding="10"
                         HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" TextWrapping="NoWrap"
                         AutomationProperties.Name="{l:Tr JsonPreview}" />
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
