<Window x:Class="TerminalTabConfigurator.Dialogs.PublishWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ajouter à Windows Terminal"
        Width="900" Height="720" MinWidth="760" MinHeight="560"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource AppBackgroundBrush}">

    <DockPanel Margin="20">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock x:Name="HeaderText" FontSize="18" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
            <TextBlock Style="{StaticResource Hint}" FontSize="12" Margin="0,4,0,0">
                <Run Text="Cible :" /> <Run x:Name="TargetName" FontWeight="SemiBold" /> <Run Text="—" /> <Run x:Name="TargetPath" FontFamily="{StaticResource MonoFont}" />
            </TextBlock>
            <Border x:Name="ElevationBanner" Visibility="Collapsed" Margin="0,12,0,0" Padding="12,10" CornerRadius="6"
                    Background="#2B2416" BorderBrush="#7A5E1E" BorderThickness="1">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource GlyphIcon}" Foreground="#F7B955" Margin="0,1,10,0"
                               VerticalAlignment="Top" Text="&#xE7BA;" />
                    <TextBlock TextWrapping="Wrap" FontSize="12">
                        <Run FontWeight="SemiBold" Text="Disposition administrateur." />
                        <Run Text="Windows Terminal ne peut pas ouvrir des volets administrateur dans une fenêtre normale : il ouvrirait une autre fenêtre avec un seul volet. Le menu, la palette et le raccourci clavier ne fonctionneront que dans une fenêtre Windows Terminal lancée en administrateur. Depuis le Bureau, le raccourci (lancé en administrateur) fonctionne toujours." />
                    </TextBlock>
                </DockPanel>
            </Border>
        </StackPanel>

        <DockPanel DockPanel.Dock="Bottom" Margin="0,16,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="Annuler" IsCancel="True" MinWidth="100" Margin="0,0,8,0" />
                <Button x:Name="PublishButton" Content="Publier" IsDefault="True" MinWidth="110" Style="{DynamicResource AccentButtonStyle}" Click="OnPublish" />
            </StackPanel>
            <TextBlock Style="{StaticResource Hint}" FontSize="12" VerticalAlignment="Center" Margin="0,0,16,0"
                       Text="Windows Terminal recharge settings.json tout seul : la disposition est disponible dès la publication." />
        </DockPanel>

        <Grid Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="330" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="OÙ L'AJOUTER" Style="{StaticResource SectionHeader}" />

                    <CheckBox IsChecked="True" IsEnabled="False">
                        <StackPanel>
                            <TextBlock Text="Palette de commandes" />
                            <TextBlock Style="{StaticResource Hint}" Text="Toujours présente : c'est l'action elle-même." Margin="0,2,0,0" />
                        </StackPanel>
                    </CheckBox>

                    <CheckBox x:Name="KeysCheck" Margin="0,12,0,0" Checked="OnOptionChanged" Unchecked="OnOptionChanged">
                        <TextBlock Text="Raccourci clavier" />
                    </CheckBox>
                    <TextBox x:Name="KeysBox" Margin="28,6,0,0" FontFamily="{StaticResource MonoFont}" FontSize="12"
                             IsEnabled="{Binding IsChecked, ElementName=KeysCheck}" TextChanged="OnKeysChanged"
                             AutomationProperties.Name="Raccourci clavier" />
                    <TextBlock Style="{StaticResource Hint}" Margin="28,4,0,0" Text="Ex. : ctrl+alt+d, ctrl+shift+1, alt+f2" />
                    <TextBlock x:Name="KeysWarning" Margin="28,4,0,0" FontSize="12" Foreground="#F7B955" TextWrapping="Wrap" Visibility="Collapsed" />

                    <CheckBox x:Name="MenuCheck" Margin="0,12,0,0" Checked="OnOptionChanged" Unchecked="OnOptionChanged">
                        <StackPanel>
                            <TextBlock Text="Menu « Nouvel onglet » (bouton ˅)" />
                            <TextBlock Style="{StaticResource Hint}" Margin="0,2,0,0"
                                       Text="Ajoutée en tête du menu ; les profils restent listés en dessous." />
                        </StackPanel>
                    </CheckBox>

                    <CheckBox x:Name="ShortcutCheck" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="Raccourci sur le Bureau" />
                            <TextBlock x:Name="ShortcutHint" Style="{StaticResource Hint}" Margin="0,2,0,0" />
                        </StackPanel>
                    </CheckBox>

                    <Border Height="1" Background="{StaticResource DividerBrush}" Margin="0,18" />

                    <CheckBox x:Name="BackupCheck" IsChecked="True">
                        <StackPanel>
                            <TextBlock Text="Sauvegarder settings.json avant" />
                            <TextBlock Style="{StaticResource Hint}" Margin="0,2,0,0"
                                       Text="Copie horodatée à côté du fichier (.ttc-backup-…). Les commentaires du fichier ne sont pas conservés à l'écriture." />
                        </StackPanel>
                    </CheckBox>
                </StackPanel>
            </ScrollViewer>

            <DockPanel Grid.Column="2">
                <TextBlock DockPanel.Dock="Top" Text="CE QUI SERA ÉCRIT DANS SETTINGS.JSON" Style="{StaticResource SectionHeader}" />
                <TextBox x:Name="JsonPreview" IsReadOnly="True" FontFamily="{StaticResource MonoFont}" FontSize="11.5"
                         Background="#141414" Foreground="{StaticResource TerminalTextBrush}" Padding="10"
                         HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" TextWrapping="NoWrap"
                         AutomationProperties.Name="Aperçu JSON" />
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
